# Copie para .env.local (fica fora do git) e ajuste.

# Desenvolvimento: de onde vêm os dados
#   csv      = retrato local do banco (pasta abaixo), com a parte restrita liberada — só no `npm run dev`
#   supabase = projeto dip-iluminacao (exige login para a parte restrita)
# O build de produção usa sempre o Supabase.
VITE_FONTE=csv

# Pasta com vw_servicos.csv, bairros.csv, categorias_revisadas.csv, vereadores.csv e amostra_fotos.csv
DADOS_LOCAIS=D:/demandas-iluminacao/base_csv

# Opcional: outro projeto Supabase (o padrão está em src/config.ts — a chave publishable é pública por definição)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
